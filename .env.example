# ==================================================
# ChatSphere Backend — .env.example
# ==================================================

# Server Port
PORT=5000

# Environment (development | production)
NODE_ENV=production

# MongoDB Connection String
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/chatsphere
MONGO_URI=mongodb://localhost:27017/chatsphere

# JWT Secret (Min 64 characters for security)
JWT_SECRET=replace_this_with_a_long_random_string_in_production

# JWT Expiry (e.g. 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Frontend URLs for CORS
# CLIENT_URL: Your production frontend URL (e.g. https://chatsphere.vercel.app)
# CLIENT_ORIGIN: Alias for CLIENT_URL
CLIENT_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security
BCRYPT_SALT_ROUNDS=12
