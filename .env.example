# =============================================
# ChatSphere Backend - Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control

# ---- Server ----
PORT=5000
NODE_ENV=development            # development | production

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/chatsphere
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/chatsphere

# ---- JWT ----
JWT_SECRET=replace_with_a_very_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d               # Token expiry (e.g. 1d, 7d, 30d)
JWT_REFRESH_SECRET=replace_with_a_different_very_long_random_secret_string
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:3000   # Frontend URL for CORS whitelist

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000          # 15 minutes in ms
RATE_LIMIT_MAX=100                   # Max requests per window per IP

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12
