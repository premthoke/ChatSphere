# ==================================================
# ChatSphere Frontend — .env.example
# Copy this file to .env and fill in real values.
# NEVER commit your .env file.
# ==================================================

# ── Development (Vite dev server with proxy) ──────────────────────────────────
# VITE_API_URL=/api
# VITE_SOCKET_URL=                 ← leave blank; SocketContext uses window.location.origin
#                                    which routes through the Vite proxy → localhost:5000

# ── Production (Vercel frontend → Render backend) ─────────────────────────────

# Full URL to the backend REST API (must end with /api).
# Used by axios in src/services/api.js as the baseURL.
VITE_API_URL=https://chatsphere-backend-br5t.onrender.com/api

# Backend origin (no trailing slash, no /api).
# Used by resolveFileUrl() in helpers.js to turn legacy relative /uploads/...
# paths into full absolute URLs for avatars and chat attachments.
VITE_API_BASE=https://chatsphere-backend-br5t.onrender.com

# Full URL to the backend Socket.IO server (same origin as VITE_API_BASE).
# Must match the domain that Render assigns to your backend service.
VITE_SOCKET_URL=https://chatsphere-backend-br5t.onrender.com
