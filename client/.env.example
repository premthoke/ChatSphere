# ==================================================
# ChatSphere Frontend — .env.example
# ==================================================

# Backend API Base URL
# In development (with Vite proxy): /api
# In production: https://chatsphere-api.herokuapp.com/api
VITE_API_URL=/api

# Backend Socket.IO URL
# In development: http://localhost:5000 (or empty for current origin)
# In production: https://chatsphere-api.herokuapp.com
VITE_SOCKET_URL=http://localhost:5000
